# Production API image. Multi-stage: build tools and the uv cache stay out of
# the runtime image, which only needs Python, the locked virtualenv, and code.
FROM python:3.12.16-slim-bookworm AS builder
WORKDIR /srv/api
ENV UV_SYSTEM_PYTHON=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /bin/
# Deps first so code edits don't bust the dependency layer. The lockfile is
# authoritative; --frozen fails instead of silently resolving new versions.
COPY pyproject.toml uv.lock ./
COPY backend/api/pyproject.toml ./backend/api/
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-dev --project backend/api

FROM python:3.12.16-slim-bookworm AS api
WORKDIR /srv/api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
  PATH="/srv/api/.venv/bin:${PATH}"

# OCI image metadata. The release workflow passes the real values as build
# arguments; the defaults mark an image that was built outside the release
# pipeline. `revision` is the link from a published image back to a commit,
# so it must never be left at its default in a released image.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG VERSION=unknown
ARG SOURCE=unknown
LABEL org.opencontainers.image.title="chaharsooq-api" \
  org.opencontainers.image.description="ChaharSooq FastAPI admin API" \
  org.opencontainers.image.vendor="ChaharSooq" \
  org.opencontainers.image.licenses="MIT" \
  org.opencontainers.image.revision="${VCS_REF}" \
  org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.created="${BUILD_DATE}" \
  org.opencontainers.image.source="${SOURCE}"

# Deterministic non-root runtime identity (group and user share UID/GID 10001).
# Secret files are consumed read-only from SECRETS_DIR=/run/secrets; the host
# must make each file readable by this UID (see AGENTS.md, section 3).
RUN groupadd --gid 10001 api \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin api

# PostgreSQL client tools for logical backups. The server runs PostgreSQL 19, and
# pg_dump refuses a newer server major, so the client must match that major. The
# Debian default (15) is too old; the pinned PGDG repository provides 19.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-19 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# Local archive directory. A named volume mounted here inherits this owner and
# mode on first use, so the non-root API user can write without an init service.
RUN mkdir -p /var/backups/charsooq \
    && chown 10001:10001 /var/backups/charsooq \
    && chmod 0700 /var/backups/charsooq

# App code and venv are root-owned and read-only to the runtime user.
COPY --from=builder /srv/api/.venv /srv/api/.venv
COPY backend/api/app ./backend/api/app
COPY backend/api/migrations ./backend/api/migrations
COPY backend/api/scripts ./backend/api/scripts
COPY backend/api/alembic.ini ./backend/api/
# Source files in the build context can carry restrictive local modes; make
# them readable to the non-root runtime without making them writable.
RUN chmod -R a+rX /srv/api/backend/api

USER api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready')"
# Multi-worker uvicorn behind the compose network: --proxy-headers trusts client
# identity headers only from the peer named by FORWARDED_ALLOW_IPS (uvicorn's own
# default is 127.0.0.1,::1, i.e. no container peer). Production sets it to the
# web container's fixed address; a wildcard is never allowed, because the login
# rate limiter keys on the client address. --no-server-header hides the version
# banner. Workers are capped at 2 — the sync lock is DB-backed so workers never
# double-run, and memory stays small on a single host.
CMD ["uvicorn", "app.main:app", "--app-dir", "backend/api", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--no-server-header"]

# Local development image: same runtime (including the PostgreSQL client used
# by backups), but uvicorn watches the source bind-mounted by compose.local.yml.
# A single reload process is enough for local edits; no rebuild is needed.
FROM api AS api-dev
CMD ["uvicorn", "app.main:app", "--app-dir", "backend/api", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "backend/api/app", "--no-server-header"]
