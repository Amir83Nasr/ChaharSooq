# چهارسوق (Charsooq): Persian RTL-first admin monorepo.

# ─── RUNTIME / SESSION STATE ──────────────────────────────
.next/
out/
.turbo
*.tsbuildinfo
next-env.d.ts
.vercel

# ─── LOGS / HISTORY / TELEMETRY ───────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── CACHE / DOWNLOADED ARTIFACTS ─────────────────────────
coverage
.coverage
playwright-report/
test-results/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# ─── BUILD / DIST ─────────────────────────────────────────
build
dist

# ─── DEPENDENCIES ─────────────────────────────────────────
node_modules
.pnp
.pnp.*
.venv/
venv/

# ─── LOCAL DATA ───────────────────────────────────────────
# Root-scoped on purpose: a bare `data/` would also match (and hide from both
# git and Tailwind's gitignore-aware scanner) any other `data/` directory,
# e.g. apps/web/components/data/.
/data/

# ─── BACKUPS ──────────────────────────────────────────────
*.bak
*.orig
*~

# ─── SECRETS / CREDENTIALS / TOKENS ───────────────────────
# Only .env.example is tracked. Real values stay local.
.env
.env.*
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.csr
*.srl

# ─── OS / EDITOR CLUTTER ──────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
TODO.md

# ─── BACKEND DEPLOY CLUTTER ───────────────────────────────
**/.fastapicloud/

# ─── ! ────────────────────────────────────────────────────
!.env.example
!.vscode/extensions.json
