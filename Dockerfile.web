FROM node:22-slim AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages/ui/package.json packages/ui/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile

# next.config.ts reads API_URL_INTERNAL when it builds the /api/* rewrite,
# so the value must be present at build time as well as at runtime.
FROM deps AS web-build
ARG API_URL_INTERNAL=http://localhost:8000
ENV API_URL_INTERNAL=${API_URL_INTERNAL}
COPY . .
RUN --mount=type=cache,target=/app/apps/web/.next/cache \
  pnpm --filter web build

FROM base AS web
ARG API_URL_INTERNAL=http://localhost:8000
ENV NODE_ENV=production API_URL_INTERNAL=${API_URL_INTERNAL}
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/apps/web/node_modules /app/apps/web/node_modules
COPY --from=deps /app/packages /app/packages
COPY --from=web-build /app/apps/web/.next /app/apps/web/.next
COPY apps/web/package.json apps/web/next.config.ts /app/apps/web/
COPY apps/web/app /app/apps/web/app
COPY apps/web/components /app/apps/web/components
COPY apps/web/lib /app/apps/web/lib
COPY apps/web/public /app/apps/web/public
COPY package.json pnpm-workspace.yaml turbo.json /app/
# Run as non-root (base image ships a `node` user).
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/login').then((r)=>{if(r.status>=500)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "web", "start"]
