# Copy to .env.local (frontend) / backend env — never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://charsooq:charsooq@localhost:5433/charsooq
SESSION_SECRET=dev-only-secret-change-me-min-32-chars
# SameSite for the session cookie: lax (same-site dev) or none (Vercel frontend + separate API host).
SESSION_SAMESITE=lax
NEXT_PUBLIC_API_URL=http://localhost:8000
# ─── LAN / MOBILE DEV ──────────────────────────────────────────
# Frontend on phone: open http://<LAN-IP>:3000 (same Wi-Fi).
# Client calls same-host :8000 automatically; explicit URL wins.
# Backend CORS allowlist (comma-separated, overrides default).
CORS_ORIGINS=http://localhost:3000,http://192.168.1.20:3000,http://192.168.1.21:3000
# Extra Next.js dev origins (comma-separated); defaults cover the two IPs above.
ALLOWED_DEV_ORIGINS=192.168.1.20,192.168.1.21
# ─── PARSINA ACCOUNTING API ────────────────────────────────────
# Optional integration; empty credentials disable manual + scheduled sync.
PARSINA_BASE_URL=
PARSINA_USERNAME=
PARSINA_PASSWORD=
PARSINA_ORG_ID=
PARSINA_YEAR=
# Optional LoadByFilter scope (warehouse / sale type).
PARSINA_WARE_ID=
PARSINA_SALE_TYPE_ID=
PARSINA_TIMEOUT_SECONDS=15
# Scheduler interval (backend daemon thread, DB-locked across workers).
PARSINA_SYNC_INTERVAL_MINUTES=15
PARSINA_SYNC_ENABLED=true
