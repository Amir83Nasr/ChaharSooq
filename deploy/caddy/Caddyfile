# Production Caddyfile — internal reverse proxy (HTTP-only or HTTPS/TLS).
#
# One site, one upstream: the Next.js `web` service. There is deliberately no
# route to the API or PostgreSQL, so browsers never talk to FastAPI directly.
#
# Protocol and TLS are selected from Configuration (no hardcoded values):
#   CHARSOOQ_PUBLIC_SCHEME        "https" (default) or "http" for explicit HTTP-only.
#   CHARSOOQ_TLS_MODE             HTTPS: organization|internal-ca. HTTP-only: none.
#   CHARSOOQ_CADDY_AUTO_HTTPS     "off" for HTTP-only (disables automatic HTTPS
#                                 redirect/cert management). "disable_redirects" or
#                                 leave default behavior for HTTPS as configured.
#
# HTTP-only mode (current temporary Production state until HTTPS is ready):
# serve plain HTTP with no TLS import, no HTTPS redirect, and no HSTS.
# HTTPS remains configurable by switching these values and providing material.
{
	# No admin API: configuration changes go through this file and a restart/reload.
	admin off
	# Never try to install a CA into the container trust store. Client trust is
	# managed by IT on the clients, not inside a read-only container.
	skip_install_trust
	auto_https {$CHARSOOQ_CADDY_AUTO_HTTPS:off}
	servers {
		# No HTTP/3: compose publishes only TCP 80/443, and QUIC/IPv6 are open
		# decisions. Without this, Caddy advertises alt-svc h3 on a UDP port that
		# nothing is listening on.
		protocols h1 h2
	}
}

{$CHARSOOQ_PUBLIC_SCHEME:https}://{$CHARSOOQ_SITE_HOST} {
	import tls-{$CHARSOOQ_TLS_MODE:organization}.caddy
	import site.caddy
}
