# Production deployment values for compose.production.yml.
# Copy this file OUTSIDE the repository, fill every required value, and source it
# in the operator shell before running production commands:
#
#   cp deploy/production.env.example /etc/charsooq/production.env
#   chmod 0600 /etc/charsooq/production.env
#   # edit /etc/charsooq/production.env with the approved values
#   set -a; . /etc/charsooq/production.env; set +a
#
# This file contains NO secrets. Secrets live as separate files under
# CHARSOOQ_SECRETS_DIR (default: /etc/charsooq/secrets) and are never put here
# or in Git. See docs/architecture/deployment.md and
# docs/operations/production-runbook.md.

# ─── REQUIRED: IMAGE SELECTION (same release, deploy by digest) ────────────────
# Both images must come from the same published GitHub Release. Use the digests
# recorded in the release body, never a moving tag.
# Example:
# CHARSOOQ_API_IMAGE=ghcr.io/<owner>/charsooq-api@sha256:<api-digest>
# CHARSOOQ_WEB_IMAGE=ghcr.io/<owner>/charsooq-web@sha256:<web-digest>
CHARSOOQ_API_IMAGE=
CHARSOOQ_WEB_IMAGE=

# ─── REQUIRED: NETWORK / EXPOSURE (IT-owned values, no defaults) ───────────────
# Approved internal IP that Caddy binds ports 80/443 to. A bare 0.0.0.0 bind is
# not allowed by compose; do not guess this address.
CHARSOOQ_PROXY_BIND_IP=

# Internal DNS name or literal IP that users open, without scheme or port.
# Must match the certificate SAN exactly when HTTPS is enabled.
CHARSOOQ_SITE_HOST=

# Blue-Green: each slot gets its own conflict-checked edge network (web <-> api)
# and a fixed web address inside it. The API of a slot trusts only that address.
# Legacy single-slot names (CHARSOOQ_EDGE_SUBNET / CHARSOOQ_WEB_EDGE_IP) are
# accepted by deploy/scripts/deploy.sh as the blue slot values for compatibility.
# Green variables are REQUIRED before deployment; do not guess or auto-generate IPs/subnets.
CHARSOOQ_EDGE_BLUE_SUBNET=
CHARSOOQ_WEB_BLUE_EDGE_IP=
CHARSOOQ_EDGE_GREEN_SUBNET=
CHARSOOQ_WEB_GREEN_EDGE_IP=

# ─── PUBLIC PROTOCOL / TLS (configuration-driven, no hardcoded values) ────────
# Current Production is HTTP-only (temporary) until HTTPS is ready:
#   CHARSOOQ_PUBLIC_SCHEME=http
#   CHARSOOQ_TLS_MODE=none
#   CHARSOOQ_CADDY_AUTO_HTTPS=off
#   CHARSOOQ_HSTS_MAX_AGE=0
# HTTPS (future, when approved and material is ready):
#   CHARSOOQ_PUBLIC_SCHEME=https
#   CHARSOOQ_TLS_MODE=organization or internal-ca
#   CHARSOOQ_CADDY_AUTO_HTTPS=off or disable_redirects (per approved Caddy behavior)
#   CHARSOOQ_HSTS_MAX_AGE=31536000 (after clients trust the root CA)
CHARSOOQ_PUBLIC_SCHEME=https
# none = explicit HTTP-only (no TLS, no redirect, no HSTS)
# organization = certificate files issued by the organization/public CA
# internal-ca  = Caddy local CA (every client must trust its root CA)
CHARSOOQ_TLS_MODE=organization
# off = required for HTTP-only to prevent automatic HTTPS redirect/cert management
CHARSOOQ_CADDY_AUTO_HTTPS=off

# HSTS max-age in seconds, set by Caddy for HTTPS modes only (the API never sets HSTS).
# Use 0 to disable enforcement while clients are still trusting the TLS root CA.
CHARSOOQ_HSTS_MAX_AGE=31536000

# Host directory mounted read-only into Caddy for certificate material.
# Unused in internal-ca/none modes (the directory may be empty).
CHARSOOQ_TLS_DIR=/etc/charsooq/tls

# ─── OPTIONAL: SECRET FILE DIRECTORY ───────────────────────────────────────────
# Host directory containing the six required secret files:
#   postgres_password, database_url, migration_database_url,
#   session_secret, owner_password, parsina_password
CHARSOOQ_SECRETS_DIR=/etc/charsooq/secrets

# ─── OPTIONAL: AUTOMATED DEPLOYMENT (self-hosted runner) ───────────────────────
# The release workflow's deploy job runs deploy/scripts/deploy.sh on the runner
# account. That account must be able to read this file and to write the state
# directory. The secret files above stay root/UID-owned; the runner never reads
# them, the Docker daemon mounts them into the containers.
#
# CA file used by the deploy script for external HTTPS health probes.
# Required when CHARSOOQ_PUBLIC_SCHEME=https. Not used for HTTP-only probes.
CHARSOOQ_CA_FILE=

# Directory where the deploy script records the active and previous image/slot
# references. It holds no secret values. Writable by the deploy/runner account.
CHARSOOQ_STATE_DIR=/etc/charsooq/state
