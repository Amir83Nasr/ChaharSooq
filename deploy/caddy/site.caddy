# Shared site body, imported into the active site in ./Caddyfile.
# Keep the upstream limited to the active web slot. Do not add the API or
# PostgreSQL here: the request path is Caddy -> web -> /api/* rewrite -> api.

encode zstd gzip

header {
	-Server
}

# Access and error logs go to stdout and are collected by `docker compose logs`.
log {
	output stdout
}

# The active slot is selected by deploy/scripts/deploy.sh, which rewrites this
# file atomically and reloads Caddy before traffic moves.
import active-upstream.caddy
