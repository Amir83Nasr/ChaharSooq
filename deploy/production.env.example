# Production deployment values for compose.production.yml.
# Copy this file OUTSIDE the repository, fill every required value, and source it
# in the operator shell before running production commands:
#
#   cp deploy/production.env.example /etc/charsooq/production.env
#   chmod 0600 /etc/charsooq/production.env
#   # edit /etc/charsooq/production.env with the approved values
#   set -a; . /etc/charsooq/production.env; set +a
#
# This file contains NO secrets. Secrets live as separate files under
# CHARSOOQ_SECRETS_DIR (default: /etc/charsooq/secrets) and are never put here
# or in Git. See docs/architecture/deployment.md and
# docs/operations/production-runbook.md.

# ─── REQUIRED: IMAGE SELECTION (same release, deploy by digest) ────────────────
# Both images must come from the same published GitHub Release. Use the digests
# recorded in the release body, never a moving tag.
# Example:
# CHARSOOQ_API_IMAGE=ghcr.io/<owner>/charsooq-api@sha256:<api-digest>
# CHARSOOQ_WEB_IMAGE=ghcr.io/<owner>/charsooq-web@sha256:<web-digest>
CHARSOOQ_API_IMAGE=
CHARSOOQ_WEB_IMAGE=

# ─── REQUIRED: NETWORK / EXPOSURE (IT-owned values, no defaults) ───────────────
# Approved internal IP that Caddy binds ports 80/443 to. A bare 0.0.0.0 bind is
# not allowed by compose; do not guess this address.
CHARSOOQ_PROXY_BIND_IP=

# Internal DNS name or literal IP that users open, without scheme or port.
# Must match the certificate SAN exactly.
CHARSOOQ_SITE_HOST=

# Conflict-checked CIDR for the web <-> api (edge) network.
CHARSOOQ_EDGE_SUBNET=

# Web container's fixed IPv4 address inside CHARSOOQ_EDGE_SUBNET. Also the only
# trusted proxy IP for the API (forwarded headers / client IP).
CHARSOOQ_WEB_EDGE_IP=

# ─── OPTIONAL: TLS ─────────────────────────────────────────────────────────────
# organization = certificate files issued by the organization/public CA (default)
# internal-ca  = Caddy local CA (every client must trust its root CA)
CHARSOOQ_TLS_MODE=organization

# Host directory mounted read-only into Caddy for certificate material.
# Unused in internal-ca mode (the directory may be empty).
CHARSOOQ_TLS_DIR=/etc/charsooq/tls

# ─── OPTIONAL: SECRET FILE DIRECTORY ───────────────────────────────────────────
# Host directory containing the six required secret files:
#   postgres_password, database_url, migration_database_url,
#   session_secret, owner_password, parsina_password
CHARSOOQ_SECRETS_DIR=/etc/charsooq/secrets
