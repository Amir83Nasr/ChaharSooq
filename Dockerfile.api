FROM python:3.12-slim AS api
WORKDIR /srv/api
ENV UV_SYSTEM_PYTHON=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY backend/api/pyproject.toml ./backend/api/
COPY backend/api/app ./backend/api/app
COPY backend/api/alembic.ini ./backend/api/
COPY backend/api/migrations ./backend/api/migrations
# uv builds the workspace venv at /srv/api/.venv.
RUN uv sync --frozen --no-dev --project backend/api

# Non-root runtime: the container only needs the venv and app sources.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin api \
    && chown -R api:api /srv/api
USER api
ENV PATH="/srv/api/.venv/bin:${PATH}"
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"
CMD ["uvicorn", "app.main:app", "--app-dir", "backend/api", "--host", "0.0.0.0", "--port", "8000"]
