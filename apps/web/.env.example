# Web — copy to apps/web/.env.local. Next.js reads this file from apps/web.
# Server-side API origin for the /api/* rewrite; falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:8000
# API origin fallback. The browser always calls same-origin /api/*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── LAN / MOBILE DEV ─────────────────────────────────────────
# Extra Next.js dev origins (comma-separated) allowed to load the dev server.
# Only needed when testing from another device, e.g. on your phone:
# ALLOWED_DEV_ORIGINS=192.168.1.20,192.168.1.21
