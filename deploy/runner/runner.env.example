# Non-secret self-hosted runner configuration for ChaharSooq Production deploys.
# Copy this file OUTSIDE the repository on the Production host, fill the
# approved values, and keep it readable only by the runner/service account.
#
#   sudo install -d -m 0750 -o <runner-user> -g <runner-group> /etc/charsooq-runner
#   sudo cp deploy/runner/runner.env.example /etc/charsooq-runner/runner.env
#   sudo chmod 0640 /etc/charsooq-runner/runner.env
#   # edit /etc/charsooq-runner/runner.env
#
# This file contains NO secrets and NO registration token. The registration
# token is generated on demand in GitHub and must never be stored in Git or in
# a long-lived file.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# GitHub repository URL for this runner (repository-scoped runner).
CHARSOOQ_RUNNER_URL=https://github.com/<owner>/ChaharSooq

# Dedicated runner label required by .github/workflows/release.yml deploy job.
# Do not reuse a shared label that other repositories/workflows can target.
CHARSOOQ_RUNNER_LABELS=charsooq-production

# Optional runner name shown in GitHub (must be unique within the repository).
# Default suggestion: market-linux-charsooq-production
CHARSOOQ_RUNNER_NAME=market-linux-charsooq-production

# Runner install directory on the host (outside this repository checkout).
# Example: /opt/actions-runner-charsooq
CHARSOOQ_RUNNER_DIR=/opt/actions-runner-charsooq

# Local user that owns/runs the runner service. Create a dedicated, non-root
# account (see AGENTS.md section 3).
CHARSOOQ_RUNNER_USER=charsooq-runner

# Group used for controlled access to deployment files/directories if needed.
# Prefer a dedicated group over broad supplementary groups.
CHARSOOQ_RUNNER_GROUP=charsooq-runner

# Runner work directory name (relative to runner dir) or absolute path policy.
# Keep the default `_work` unless IT has a reason to change it.
CHARSOOQ_RUNNER_WORK=_work

# Disable automatic runner updates only if change control requires it; prefer
# GitHub-managed updates where possible and document the chosen policy.
CHARSOOQ_RUNNER_DISABLE_UPDATE=false
