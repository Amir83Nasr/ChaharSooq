# Backend — copy to backend/api/.env.local. Never commit real secrets.
# Read by the API, Alembic, and the seed scripts from any working directory.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://charsooq:charsooq@localhost:5433/charsooq
SESSION_SECRET=dev-only-secret-change-me-min-32-chars
# SameSite for the session cookie: lax (same-site dev) or none (Vercel frontend + separate API host).
SESSION_SAMESITE=lax
# CORS allowlist (comma-separated). Add your LAN origin when testing the UI from a phone,
# e.g. http://192.168.1.20:3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ─── PARSINA ACCOUNTING API ────────────────────────────────────
# Optional integration; empty credentials disable manual + scheduled sync.
PARSINA_BASE_URL=
PARSINA_USERNAME=
PARSINA_PASSWORD=
PARSINA_ORG_ID=
PARSINA_YEAR=
# Optional LoadByFilter scope (warehouse / sale type).
PARSINA_WARE_ID=
PARSINA_SALE_TYPE_ID=
PARSINA_TIMEOUT_SECONDS=15
# Scheduler interval (backend daemon thread, DB-locked across workers).
PARSINA_SYNC_INTERVAL_MINUTES=60
PARSINA_SYNC_ENABLED=true
# ─── COMPETITOR PRODUCT PRICES ─────────────────────────────────
# Per-host minimum request interval and price freshness window.
COMPETITOR_REQUEST_INTERVAL_SECONDS=5
COMPETITOR_PRICE_TTL_HOURS=24
# ─── DEV PRODUCT DATA ─────────────────────────────────────────
# APP_ENV=development reads products from this CSV instead of Parsina.
# Unset/empty uses <repo>/data/parsina.csv; load it with
# `make db-seed-parsina` (replaces the dev product mirror).
# PRODUCTS_CSV_PATH=/absolute/path/to/parsina.csv
# ─── PROD SYNC SIMULATION (DEV DATABASE) ────────────────────────
# When set, APP_ENV=production syncs products from this dev database instead
# of the live Parsina API — the "به‌روزرسانی از پارسینا" button and the
# scheduler copy the dev mirror through the same validation/apply path.
# Point it at the dev Postgres (local or a hosted dev branch); empty disables
# the simulation and production uses Parsina credentials.
# DEV_DATABASE_URL=postgresql+psycopg://charsooq:charsooq@localhost:5433/charsooq
