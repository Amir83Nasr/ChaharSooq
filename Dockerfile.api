# Production API image. Multi-stage: build tools and the uv cache stay out of
# the runtime image, which only needs Python, the locked virtualenv, and code.
FROM python:3.12.16-slim-bookworm AS builder
WORKDIR /srv/api
ENV UV_SYSTEM_PYTHON=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /bin/
# Deps first so code edits don't bust the dependency layer. The lockfile is
# authoritative; --frozen fails instead of silently resolving new versions.
COPY pyproject.toml uv.lock ./
COPY backend/api/pyproject.toml ./backend/api/
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-dev --project backend/api

FROM python:3.12.16-slim-bookworm AS api
WORKDIR /srv/api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
  PATH="/srv/api/.venv/bin:${PATH}"

# Deterministic non-root runtime identity (group and user share UID/GID 10001).
# Secret files are consumed read-only from SECRETS_DIR=/run/secrets; the host
# must make each file readable by this UID (see docs/architecture/deployment.md).
RUN groupadd --gid 10001 api \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin api

# App code and venv are root-owned and read-only to the runtime user.
COPY --from=builder /srv/api/.venv /srv/api/.venv
COPY backend/api/app ./backend/api/app
COPY backend/api/migrations ./backend/api/migrations
COPY backend/api/scripts ./backend/api/scripts
COPY backend/api/alembic.ini ./backend/api/
# Source files in the build context can carry restrictive local modes; make
# them readable to the non-root runtime without making them writable.
RUN chmod -R a+rX /srv/api/backend/api

USER api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready')"
# Multi-worker uvicorn behind the compose network: --proxy-headers trusts the
# platform proxy for client IPs (rate limiting), --no-server-header hides the
# version banner. Workers are capped at 2 — the sync lock is DB-backed so
# workers never double-run, and memory stays small on a single host.
CMD ["uvicorn", "app.main:app", "--app-dir", "backend/api", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--no-server-header"]
