# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# چهارسوق (Charsooq): Persian RTL-first admin monorepo.

# ─── RUNTIME / BUILD OUTPUT ───────────────────────────────────
.next/
out/
.turbo
*.tsbuildinfo
next-env.d.ts
.vercel
build
dist

# ─── DEPENDENCIES ─────────────────────────────────────────────
node_modules
.pnp
.pnp.*
.venv/
venv/

# ─── LOGS ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── TESTS / COVERAGE / TOOL CACHES ───────────────────────────
coverage
.coverage
playwright-report/
test-results/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# ─── SECRETS / CREDENTIALS ────────────────────────────────────
# Only .env.example is tracked. Real values stay local.
.env
.env.*
!.env.example
*.pem
*.key

# ─── LOCAL DATA / BACKUPS ─────────────────────────────────────
data/
*.bak
*.orig
*~

# ─── OS / EDITOR ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
